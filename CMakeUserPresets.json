{
    "version": 2,
    "configurePresets": [
        {
            "name": "vcpkg",
            "inherits": "default",
            "environment":{
                "VCPKG_ROOT": "/opt/vcpkg"
            }
        },
        {
            "name": "tsan",
            "inherits": "default",
            "cacheVariables": {
                "ENABLE_TSAN": "ON"
            },
            "environment":{
                "VCPKG_ROOT": "/opt/vcpkg"
            }
        }
    ]
}